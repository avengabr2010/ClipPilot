# =============================================================================
# ClipPilot — environment variables
# Copy to web/.env.local (web app) and worker/.env (worker). Never commit secrets.
# =============================================================================

# --- Supabase (Project Settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: NEVER expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the web app (used in e-mail links and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Owner ------------------------------------------------------------------------
# The verified account with this e-mail gets the OWNER role (unlimited premium).
# Apply with: cd web && npm run owner:init
OWNER_EMAIL=

# --- Stripe (optional — paid plans stay closed until all are set) --------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=

# Signed download/preview URL lifetime (seconds)
SIGNED_URL_TTL_SECONDS=3600

# Admin dashboard cost estimates (EUR)
COST_PER_COMPUTE_HOUR_EUR=0.05
COST_PER_GB_MONTH_EUR=0.021

# =============================================================================
# Worker (worker/.env)
# =============================================================================
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY= (same value as above)
WORKER_ID=
WORKER_CONCURRENCY=1
WORKER_JOB_TYPES=process_video,render_clip
WORKER_POLL_INTERVAL=3
JOB_TIMEOUT_SECONDS=10800
WORKER_TMP_DIR=/tmp/clippilot
# faster-whisper model: tiny | base | small | medium | large-v3 (quality vs speed)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=
# Optional LLM refinement of titles/ranking (only transcripts are sent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
SOURCE_RETENTION_DAYS=7
EXPORT_RETENTION_DAYS=30
FFMPEG_THREADS=0
